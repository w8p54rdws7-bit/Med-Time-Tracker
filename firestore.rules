rules_version = '2';
// Copy these rules into Firebase console → Firestore Database → Rules → Publish.
// Households are identified by an unguessable 26-char random ID (the share link).
// Listing the households collection is denied; you must know the ID to read/write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{hid} {
      allow get, create, update: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
